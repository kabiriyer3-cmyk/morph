{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morph",
  "version": "0.4.0",
  "identifier": "app.morph.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Morph",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0b0d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Morph",
    "category": "Utility",
    "copyright": "MIT License",
    "shortDescription": "Node-based multitool for your files",
    "longDescription": "Morph is a node-based batch tool for converting, compressing and transforming images, video, audio, 3D models, archives, data files and documents.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
